#!/usr/bin/env python3
"""
Thermal: Report CPU and GPU temperatures from available system sensors.
Usage: thermal
"""

import subprocess
import platform
import os
import re

# -- fmt ---------------------------------------------------------------------
import os as _os; _e = _os.environ
_C = "NO_COLOR" not in _e and bool(_e.get("FORCE_COLOR")=="1" or _e.get("WT_SESSION") or _e.get("ANSICON") or _e.get("TERM_PROGRAM") or _e.get("TERM","") not in ("","dumb"))
def section(t): print(f"\n\033[36m=== {t} ===\033[0m" if _C else f"\n=== {t} ===")
def info(m):    print(f"\033[90m[*]\033[0m {m}"       if _C else f"[*] {m}")
def ok(m):      print(f"\033[32m[+]\033[0m {m}"       if _C else f"[+] {m}")
def err(m):     print(f"\033[31m[-]\033[0m {m}"       if _C else f"[-] {m}")
def warn(m):    print(f"\033[33m[!]\033[0m {m}"       if _C else f"[!] {m}")
# -----------------------------------------------------------------------------

LABEL_WIDTH = 24


def _natural_key(name):
    """Sort 'temp10' after 'temp2' instead of between 'temp1' and 'temp2'."""
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", name)]


def _read(path):
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        return f.read().strip()


def linux_thermal_zones():
    """ACPI/platform thermal zones from /sys/class/thermal."""
    rows = []
    base = "/sys/class/thermal/"
    if not os.path.exists(base):
        return rows
    for zone in sorted(os.listdir(base), key=_natural_key):
        if not zone.startswith("thermal_zone"):
            continue
        try:
            label = _read(os.path.join(base, zone, "type"))
            temp = int(_read(os.path.join(base, zone, "temp"))) / 1000.0
            rows.append((label, temp))
        except Exception:
            continue
    return rows


def linux_hwmon():
    """Chip sensors (per-core CPU, NVMe, motherboard, NIC...) from /sys/class/hwmon."""
    rows = []
    base = "/sys/class/hwmon/"
    if not os.path.exists(base):
        return rows
    for hw in sorted(os.listdir(base), key=_natural_key):
        hw_path = os.path.join(base, hw)
        # Skip chips that just mirror a thermal zone (already listed above)
        try:
            device = os.path.basename(os.readlink(os.path.join(hw_path, "device")))
            if device.startswith("thermal_zone"):
                continue
        except OSError:
            pass
        try:
            chip = _read(os.path.join(hw_path, "name"))
        except Exception:
            chip = hw
        try:
            inputs = [f for f in os.listdir(hw_path) if re.match(r"temp\d+_input$", f)]
        except Exception:
            continue
        for inp in sorted(inputs, key=_natural_key):
            sensor = inp[:-len("_input")]
            try:
                temp = int(_read(os.path.join(hw_path, inp))) / 1000.0
            except Exception:
                continue
            try:
                label = _read(os.path.join(hw_path, sensor + "_label")) or sensor
            except Exception:
                label = sensor
            rows.append((f"{chip} {label}", temp))
    return rows


def print_row(label, temp):
    print(f"  {label:<{LABEL_WIDTH}}: {temp:.1f}\u00B0C")


def print_thermal_data():
    os_name = platform.system()

    try:
        if os_name == "Linux":
            rows = linux_thermal_zones() + linux_hwmon()
            if rows:
                for label, temp in rows:
                    print_row(label, temp)
            else:
                warn("No sensors found in /sys/class/thermal or /sys/class/hwmon (common in VMs/containers)")

        elif os_name == "Windows":
            found = False
            try:
                cmd = [
                    "powershell",
                    "-Command",
                    "Get-CimInstance -Namespace root/wmi -ClassName MSAcpi_ThermalZoneTemperature | Select-Object -ExpandProperty CurrentTemperature"
                ]
                output = subprocess.check_output(cmd, stderr=subprocess.STDOUT).decode("utf-8", errors="ignore")
                temps = re.findall(r"(\d+)", output)
                for i, t in enumerate(temps):
                    celsius = (int(t) / 10.0) - 273.15
                    print_row(f"ThermalZone {i}", celsius)
                    found = True
            except Exception:
                pass
            if not found:
                warn("CPU thermal data not available via standard Windows APIs. Consider LibreHardwareMonitor/OpenHardwareMonitor for full info.")

        elif os_name == "Darwin":
            cmd = "sudo powermetrics -n 1 --samplers smc | grep -i 'CPU die temperature'"
            try:
                output = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT).decode()
                print(f"  {output.strip()}")
            except Exception:
                warn("macOS thermal data requires 'sudo' or isn't accessible via standard CLI.")

        try:
            gpu_cmd = ["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits"]
            gpu_temp = subprocess.check_output(gpu_cmd, stderr=subprocess.DEVNULL).decode().strip()
            if gpu_temp:
                for i, t in enumerate(gpu_temp.splitlines()):
                    print_row("NVIDIA GPU" + (f" {i}" if i else ""), float(t))
        except Exception:
            pass

    except Exception as e:
        warn(f"Error fetching data: {str(e)}")


def main():
    section("Thermal Sensors")
    print_thermal_data()
    print()

if __name__ == "__main__":
    main()