#!/usr/bin/env python3
"""
Largest: List the N largest files under a directory tree.
Usage: largest [path] [limit]
"""

import os
import sys

# -- fmt ---------------------------------------------------------------------
import os as _os; _e = _os.environ
_C = "NO_COLOR" not in _e and bool(_e.get("FORCE_COLOR")=="1" or _e.get("WT_SESSION") or _e.get("ANSICON") or _e.get("TERM_PROGRAM") or _e.get("TERM","") not in ("","dumb"))
def section(t): print(f"\n\033[36m=== {t} ===\033[0m" if _C else f"\n=== {t} ===")
def info(m):    print(f"\033[90m[*]\033[0m {m}"       if _C else f"[*] {m}")
def ok(m):      print(f"\033[32m[+]\033[0m {m}"       if _C else f"[+] {m}")
def err(m):     print(f"\033[31m[-]\033[0m {m}"       if _C else f"[-] {m}")
def warn(m):    print(f"\033[33m[!]\033[0m {m}"       if _C else f"[!] {m}")
# -----------------------------------------------------------------------------

def human_readable(size):
    for unit in ["B", "K", "M", "G", "T"]:
        if size < 1024:
            return f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}P"

def parse_args():
    path = "."
    limit = 10

    if len(sys.argv) >= 2:
        path = sys.argv[1]

    if len(sys.argv) >= 3:
        try:
            limit = int(sys.argv[2])
        except ValueError:
            err(f"Invalid number for limit: {sys.argv[2]}")
            print()
            sys.exit(1)

    return path, limit

def collect_files(root):
    files = []
    last_len = 0

    for dirpath, _, filenames in os.walk(root):
        label = f"[*] Scanning: {dirpath}"[:75]
        colored = ("\033[90m[*]\033[0m" + label[3:]) if _C else label
        print("\r" + colored + " " * max(0, last_len - len(label)), end="", flush=True)
        last_len = len(label)

        for name in filenames:
            full_path = os.path.join(dirpath, name)
            try:
                size = os.path.getsize(full_path)
                files.append((size, full_path))
            except Exception:
                continue

    print("\r" + " " * last_len + "\r", end="", flush=True)
    return files

def main():
    root, limit = parse_args()

    section(f"Largest Files in '{root}'")

    if not os.path.exists(root):
        err(f"Path does not exist: {root}")
        print()
        sys.exit(1)

    files = collect_files(root)
    files.sort(key=lambda x: x[0], reverse=True)

    top = files[:limit]

    if not top:
        print("No files found.")
    else:
        for size, path in top:
            print(f"{human_readable(size):>8}  {path}")

    print()

if __name__ == "__main__":
    main()