#!/usr/bin/env python3
"""
Drivers: List installed system drivers and their versions.
Usage: drivers [filter]
"""

import subprocess
import platform
import sys
import re

# -- fmt ---------------------------------------------------------------------
import os as _os; _e = _os.environ
_C = "NO_COLOR" not in _e and bool(_e.get("FORCE_COLOR")=="1" or _e.get("WT_SESSION") or _e.get("ANSICON") or _e.get("TERM_PROGRAM") or _e.get("TERM","") not in ("","dumb"))
def section(t): print(f"\n\033[36m=== {t} ===\033[0m" if _C else f"\n=== {t} ===")
def info(m):    print(f"\033[90m[*]\033[0m {m}"       if _C else f"[*] {m}")
def ok(m):      print(f"\033[32m[+]\033[0m {m}"       if _C else f"[+] {m}")
def err(m):     print(f"\033[31m[-]\033[0m {m}"       if _C else f"[-] {m}")
def warn(m):    print(f"\033[33m[!]\033[0m {m}"       if _C else f"[!] {m}")
# -----------------------------------------------------------------------------

def get_linux_version(module_name):
    """Linux specific: get version using modinfo."""
    try:
        output = subprocess.check_output(["modinfo", "-F", "version", module_name],
                                         stderr=subprocess.DEVNULL).decode().strip()
        return output if output else "N/A"
    except Exception:
        return "N/A"

def get_installed_drivers():
    os_name = platform.system()
    results = []

    try:
        if os_name == "Windows":
            # /V is verbose (includes version), /FO CSV makes it easy to parse
            output = subprocess.check_output(["driverquery", "/V", "/FO", "CSV"]).decode('utf-8', errors='ignore')
            return output

        elif os_name == "Linux":
            lsmod_out = subprocess.check_output(["lsmod"]).decode().splitlines()
            
            header = f"{'Module':<25} {'Version':<20} {'Used by':<20}"
            results.append(header)
            results.append("-" * len(header))

            for line in lsmod_out[1:]:
                parts = line.split()
                if len(parts) > 0:
                    module_name = parts[0]
                    used_by = parts[3] if len(parts) > 3 else ""
                    version = get_linux_version(module_name)
                    
                    if "nvidia" in module_name and version == "N/A":
                        try:
                            with open("/proc/driver/nvidia/version", "r", encoding="utf-8", errors="replace") as f:
                                ver_match = re.search(r"Kernel Module\s+([\d\.]+)", f.read())
                                if ver_match: version = ver_match.group(1)
                        except: pass
                    
                    results.append(f"{module_name:<25} {version:<20} {used_by:<20}")
            
            return "\n".join(results)

        elif os_name == "Darwin":
            output = subprocess.check_output(["kextstat"]).decode()
            return output

        else:
            warn("Unsupported platform.")
            return None

    except Exception as e:
        warn(f"Error fetching driver data: {e}")
        return None


def main():
    search_term = sys.argv[1].lower() if len(sys.argv) > 1 else None

    section("System Drivers")
    driver_data = get_installed_drivers()

    if driver_data is None:
        print()
        sys.exit(1)

    if search_term:
        lines = driver_data.splitlines()
        header = lines[0:2] if len(lines) >= 2 else []
        matches = [line for line in lines[2:] if search_term in line.lower()]

        if matches:
            print("\n".join(header + matches))
        else:
            warn(f"No drivers found matching '{search_term}'")
    else:
        print(driver_data)

    print()

if __name__ == "__main__":
    main()