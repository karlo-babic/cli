#!/usr/bin/env python3
"""
Search: Semantic full-text search over a plain-text file using TF-IDF and fuzzy matching.
Usage: search <file> "<query>" [top_k]
"""

import os
import sys
import math
import re
import heapq
from collections import Counter

# -- fmt ---------------------------------------------------------------------
