def print_terminal_diff(old_lines, new_lines, old_name, new_name):
    ADD  = "\033[32m" if _C else ""
    DEL  = "\033[31m" if _C else ""
    HUNK = "\033[36m" if _C else ""
    DIM  = "\033[90m" if _C else ""
    RST  = "\033[0m"  if _C else ""
    diff = list(difflib.unified_diff(
        old_lines, new_lines, fromfile=old_name, tofile=new_name, lineterm=""))
    if not diff:
        info("Files are identical.")
        return
    for line in diff:
        if line.startswith(("---", "+++")):  print(f"{HUNK}{line}{RST}")
        elif line.startswith("@@"):           print(f"{HUNK}{line}{RST}")
        elif line.startswith("+"):            print(f"{ADD}{line}{RST}")
        elif line.startswith("-"):            print(f"{DEL}{line}{RST}")
        else:                                 print(f"{DIM}{line}{RST}")


def main():
    section("Diff")

    args = sys.argv[1:]
    html_mode = "--html" in args
    args = [a for a in args if a != "--html"]

    if len(args) != 2:
        print("Usage: diff <old_file> <new_file> [--html]")
        print()
        sys.exit(1)

    old_path, new_path = args[0], args[1]

    for path in (old_path, new_path):
        if not os.path.isfile(path):
            err(f"File not found: {path}")
            print()
            sys.exit(1)

    info(f"Reading {old_path}")
    old_lines = read_file(old_path)
    info(f"Reading {new_path}")
    new_lines = read_file(new_path)

    if html_mode:
        info("Building HTML diff...")
        page = build_html(old_lines, new_lines, old_path, new_path)
        out = "diff_output.html"
        with open(out, "w", encoding="utf-8") as f:
            f.write(page)
        ok(f"Saved to {out}")
    else:
        print_terminal_diff(old_lines, new_lines, old_path, new_path)

    print()


if __name__ == "__main__":
    main()
