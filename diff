  --add-bg:  #E3F2FD; --add-acc: #1457A8; --add-ln: #BBDEFB;
  --ctx-bg:  #FFFFFF; --ctx-ln:  #F5F5F5; --border: #E0E0E0;
  --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}}
