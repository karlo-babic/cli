#!/usr/bin/env python3
"""
Bundle: A CLI tool to flatten a local codebase or public Git repository into a single text file.
Usage: bundle <output_file> <root_dir_or_url> [.ext1 .ext2 ...]
"""

import os
import sys
import tempfile
import subprocess
import contextlib
from datetime import datetime

# -- fmt ---------------------------------------------------------------------
import os as _os; _e = _os.environ
_C = "NO_COLOR" not in _e and bool(_e.get("FORCE_COLOR")=="1" or _e.get("WT_SESSION") or _e.get("ANSICON") or _e.get("TERM_PROGRAM") or _e.get("TERM","") not in ("","dumb"))
def section(t): print(f"\n\033[36m=== {t} ===\033[0m" if _C else f"\n=== {t} ===")
def info(m):    print(f"\033[90m[*]\033[0m {m}"       if _C else f"[*] {m}")
def ok(m):      print(f"\033[32m[+]\033[0m {m}"       if _C else f"[+] {m}")
def err(m):     print(f"\033[31m[-]\033[0m {m}"       if _C else f"[-] {m}")
def warn(m):    print(f"\033[33m[!]\033[0m {m}"       if _C else f"[!] {m}")
# -----------------------------------------------------------------------------

# config - directories we always skip
IGNORED_DIRS = {
    ".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build"
}

# extensions we skip ONLY if no specific extensions are provided as arguments
IGNORED_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".gif", ".bmp", ".ico",
    ".exe", ".dll", ".so", ".dylib",
    ".zip", ".tar", ".gz", ".rar",
    ".pdf", ".mp4", ".mp3", ".bak"
}

# lockfiles: huge and rarely useful; skipped ONLY if no extensions are provided
IGNORED_FILENAMES = {
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb",
    "poetry.lock", "Pipfile.lock", "uv.lock", "pdm.lock",
    "Cargo.lock", "composer.lock", "Gemfile.lock", "go.sum", "flake.lock"
}

MAX_FILE_SIZE = 1024 * 1024  # truncation limit per file (1 MB)


def is_valid_file(filepath, allowed_extensions):
    _, ext = os.path.splitext(filepath)
    ext = ext.lower()

    if allowed_extensions:
        # If specific extensions were provided, ONLY allow those
        return ext in allowed_extensions
    else:
        # Otherwise, allow everything EXCEPT the ignored lists
        return (ext not in IGNORED_EXTENSIONS
                and os.path.basename(filepath) not in IGNORED_FILENAMES)


def is_binary(filepath):
    """Check if a file is binary by looking for a null byte in the first 1024 bytes."""
    try:
        with open(filepath, "rb") as f:
            return b'\0' in f.read(1024)
    except Exception:
        return True


def clone_repository(url, dest_dir):
    """Clones a git repository into a target directory with depth 1 to speed up processing."""
    try:
        subprocess.run(
            ["git", "clone", "--depth", "1", url, dest_dir],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
    except subprocess.CalledProcessError as e:
        err(f"Error cloning repository: {e.stderr}")
        print()
        sys.exit(1)
    except FileNotFoundError:
        err("'git' not found. Install Git to bundle from a URL.")
        print()
        sys.exit(1)


def git_list_files(root_dir):
    """
    Return paths (relative to root_dir) that git would track: committed files
    plus untracked ones not excluded by .gitignore. None if not a git repo or
    git is unavailable.
    """
    try:
        out = subprocess.run(
            ["git", "-C", root_dir, "ls-files", "-z",
             "--cached", "--others", "--exclude-standard"],
            check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    paths = [p for p in out.decode("utf-8", errors="replace").split("\0") if p]
    # Empty: root_dir is itself git-ignored inside a parent repo; walk it instead
    return paths or None


def walk_files(root_dir):
    """Return all file paths (relative to root_dir), skipping IGNORED_DIRS."""
    paths = []
    for dirpath, dirnames, filenames in os.walk(root_dir):
        # Filter directories in-place
        dirnames[:] = [d for d in dirnames if d not in IGNORED_DIRS]
        for filename in filenames:
            paths.append(os.path.relpath(os.path.join(dirpath, filename), root_dir))
    return paths


def collect_files(root_dir, allowed_extensions, exclude_path=None):
    file_paths = []

    candidates = git_list_files(root_dir)
    if candidates is not None:
        info("Git repository detected. Respecting .gitignore.")
    else:
        candidates = walk_files(root_dir)

    for rel_path in candidates:
        rel_path = rel_path.replace("\\", "/")  # normalize
        if any(part in IGNORED_DIRS for part in rel_path.split("/")[:-1]):
            continue

        full_path = os.path.join(root_dir, rel_path)

        # Tracked files deleted from the working tree, submodule dirs, etc.
        if not os.path.isfile(full_path):
            continue

        # Never bundle the output file into itself (e.g. on a re-run)
        if exclude_path and os.path.abspath(full_path) == exclude_path:
            continue

        # Skip if extension not allowed or file is binary
        if not is_valid_file(full_path, allowed_extensions) or is_binary(full_path):
            continue

        file_paths.append((rel_path, full_path))

    return sorted(file_paths)


def read_file_with_limit(filepath):
    try:
        truncated = os.path.getsize(filepath) > MAX_FILE_SIZE
        with open(filepath, "r", encoding="utf-8", errors="replace") as f:
            content = f.read(MAX_FILE_SIZE)
    except Exception as e:
        return f"[ERROR READING FILE: {e}]\n", False

    if truncated:
        content += "\n[FILE TRUNCATED: exceeds 1 MB size limit]\n"

    return content, truncated


def format_tokens(n):
    return f"{n / 1_000_000:.1f}M" if n >= 1_000_000 else f"{n / 1000:.0f}k" if n >= 1000 else str(n)


def write_output(source_name, files, output_file):
    """Write the bundle; return the list of truncated file paths."""
    truncated_files = []
    try:
        with open(output_file, "w", encoding="utf-8") as out:

            # global header
            out.write("===== CODEBASE EXPORT =====\n")
            out.write(f"SOURCE: {source_name}\n")
            out.write(f"TOTAL FILES: {len(files)}\n")
            out.write(f"GENERATED: {datetime.now().isoformat()}\n")
            out.write("===========================\n\n")

            # file index
            out.write("===== FILE INDEX =====\n")
            for i, (rel_path, _) in enumerate(files, 1):
                out.write(f"{i}. {rel_path}\n")
            out.write("======================\n\n")

            # file contents
            for rel_path, full_path in files:
                content, truncated = read_file_with_limit(full_path)
                if truncated:
                    truncated_files.append(rel_path)

                out.write("===== FILE START =====\n")
                out.write(f"PATH: {rel_path}\n")
                out.write("-----\n\n")

                out.write(content)
                if not content.endswith("\n"):
                    out.write("\n")

                out.write("\n===== FILE END =====\n\n")
    except Exception as e:
        err(f"Error writing to output file: {e}")
        print()
        sys.exit(1)
    return truncated_files


def main():
    if len(sys.argv) < 3:
        section("Codebase Bundler")
        print("Usage: bundle <output_file> <root_dir_or_url> [.ext1 .ext2 ...]")
        print("Example 1: bundle dump.txt ./my_project .py .js .css")
        print("Example 2: bundle dump.txt https://github.com/user/repo .py")
        print()
        sys.exit(1)

    output_file = sys.argv[1]
    root_arg = sys.argv[2]
    
    # Process optional extensions: ensure they start with a dot and are lowercase
    allowed_extensions = set()
    if len(sys.argv) > 3:
        for ext in sys.argv[3:]:
            if not ext.startswith("."):
                ext = "." + ext
            allowed_extensions.add(ext.lower())

    is_url = root_arg.startswith(("http://", "https://", "git@"))

    section("Codebase Bundler")

    # ExitStack ensures temporary directories are cleaned up gracefully if used
    with contextlib.ExitStack() as stack:
        if is_url:
            info(f"Cloning repository: {root_arg} ...")
            temp_dir = stack.enter_context(tempfile.TemporaryDirectory())
            clone_repository(root_arg, temp_dir)

            root_dir = temp_dir
            source_name = root_arg
        else:
            root_dir = root_arg
            source_name = os.path.abspath(root_dir)
            if not os.path.isdir(root_dir):
                err(f"Directory not found: '{root_dir}'")
                print()
                sys.exit(1)

        info(f"Scanning: {source_name}")
        if allowed_extensions:
            info(f"Filtering for extensions: {', '.join(allowed_extensions)}")
        else:
            info("No extension list provided. Using default exclusion list.")

        files = collect_files(root_dir, allowed_extensions, os.path.abspath(output_file))
        truncated_files = write_output(source_name, files, output_file)
        for rel_path in truncated_files:
            warn(f"Truncated (over 1 MB): {rel_path}")

        # Rough LLM token estimate: ~4 characters per token
        with open(output_file, "r", encoding="utf-8", errors="replace") as f:
            tokens = len(f.read()) // 4
        ok(f"Done. Exported {len(files)} files (~{format_tokens(tokens)} tokens) to {output_file}")
        print()


if __name__ == "__main__":
    main()