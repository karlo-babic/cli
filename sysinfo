#!/usr/bin/env python3
"""
Sysinfo: Print a summary of OS, CPU, RAM, GPU, and disk information for the current system.
Usage: sysinfo
"""

import os
import re
import sys
import time
import shutil
import platform
import subprocess

# -- fmt ---------------------------------------------------------------------
import os as _os; _e = _os.environ
_C = "NO_COLOR" not in _e and bool(_e.get("FORCE_COLOR")=="1" or _e.get("WT_SESSION") or _e.get("ANSICON") or _e.get("TERM_PROGRAM") or _e.get("TERM","") not in ("","dumb"))
def section(t): print(f"\n\033[36m=== {t} ===\033[0m" if _C else f"\n=== {t} ===")
def info(m):    print(f"\033[90m[*]\033[0m {m}"       if _C else f"[*] {m}")
def ok(m):      print(f"\033[32m[+]\033[0m {m}"       if _C else f"[+] {m}")
def err(m):     print(f"\033[31m[-]\033[0m {m}"       if _C else f"[-] {m}")
def warn(m):    print(f"\033[33m[!]\033[0m {m}"       if _C else f"[!] {m}")
# -----------------------------------------------------------------------------

# Filesystem types that are real storage (Linux /proc/mounts); everything else
# (tmpfs, proc, overlay, snap squashfs, ...) is skipped
REAL_FS = {
    "ext2", "ext3", "ext4", "btrfs", "xfs", "zfs", "f2fs", "jfs", "reiserfs", "bcachefs",
    "vfat", "exfat", "ntfs", "ntfs3", "fuseblk", "hfsplus", "apfs", "nfs", "nfs4", "cifs", "smb3"
}

def run_command(cmd):
    try:
        env = os.environ.copy()
        env["LC_ALL"] = "C"  # force standard locale
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, env=env).decode().strip()
    except Exception:
        return None

def format_duration(seconds):
    seconds = int(seconds)
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    return f"{d}d {h}h {m}m" if d else f"{h}h {m}m"

def get_linux_distro():
    try:
        with open("/etc/os-release", encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except Exception:
        pass
    return None

def get_uptime():
    os_name = platform.system()
    try:
        if os_name == "Linux":
            with open("/proc/uptime", encoding="utf-8", errors="replace") as f:
                return format_duration(float(f.read().split()[0]))
        elif os_name == "Darwin":
            # e.g. "{ sec = 1700000000, usec = 0 } Mon Nov 13 ..."
            out = run_command("sysctl -n kern.boottime")
            boot = int(re.search(r"sec = (\d+)", out).group(1))
            return format_duration(time.time() - boot)
        elif os_name == "Windows":
            import ctypes
            ctypes.windll.kernel32.GetTickCount64.restype = ctypes.c_uint64
            return format_duration(ctypes.windll.kernel32.GetTickCount64() / 1000)
    except Exception:
        pass
    return None

def get_cpu_model():
    os_name = platform.system()
    if os_name == "Linux":
        try:
            with open("/proc/cpuinfo", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.lower().startswith("model name"):
                        return line.split(":", 1)[1].strip()
        except Exception:
            pass
        # e.g. ARM boards without "model name" in /proc/cpuinfo
        if shutil.which("lscpu"):
            model = run_command("lscpu | grep 'Model name' | cut -d: -f2")
            if model:
                return model.strip()
        else:
            warn("lscpu not found, CPU model info may be limited  (install: util-linux)")
    elif os_name == "Darwin":
        model = run_command("sysctl -n machdep.cpu.brand_string")
        if model:
            return model
    elif os_name == "Windows":
        try:
            import winreg
            key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
                                 r"HARDWARE\DESCRIPTION\System\CentralProcessor\0")
            return winreg.QueryValueEx(key, "ProcessorNameString")[0].strip()
        except Exception:
            pass
    return platform.processor() or "Unknown"

def get_cpu_info():
    return {
        "model": get_cpu_model(),
        "cores": os.cpu_count(),
        "arch": platform.machine(),
    }

def get_ram_info():
    meminfo = {}
    os_name = platform.system()

    if os_name == "Linux":
        try:
            values = {}
            with open("/proc/meminfo", encoding="utf-8", errors="replace") as f:
                for line in f:
                    key, _, rest = line.partition(":")
                    values[key] = int(rest.split()[0])  # kB
            meminfo["total"] = f"{values['MemTotal'] // 1024} MB"
            meminfo["available"] = f"{values['MemAvailable'] // 1024} MB"
            swap_total = values.get("SwapTotal", 0)
            swap_used = swap_total - values.get("SwapFree", 0)
            meminfo["swap total"] = f"{swap_total // 1024} MB"
            meminfo["swap used"] = f"{swap_used // 1024} MB"
        except Exception:
            pass

    elif os_name == "Windows":
        try:
            import ctypes
            # Use ctypes to query Windows API directly (faster and more reliable than subprocess/powershell)
            class MEMORYSTATUSEX(ctypes.Structure):
                _fields_ = [
                    ("dwLength", ctypes.c_uint32),
                    ("dwMemoryLoad", ctypes.c_uint32),
                    ("ullTotalPhys", ctypes.c_uint64),
                    ("ullAvailPhys", ctypes.c_uint64),
                    ("ullTotalPageFile", ctypes.c_uint64),
                    ("ullAvailPageFile", ctypes.c_uint64),
                    ("ullTotalVirtual", ctypes.c_uint64),
                    ("ullAvailVirtual", ctypes.c_uint64),
                    ("ullAvailExtendedVirtual", ctypes.c_uint64),
                ]
            stat = MEMORYSTATUSEX()
            stat.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
            ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(stat))

            meminfo["total"] = f"{stat.ullTotalPhys // (1024**2)} MB"
            meminfo["available"] = f"{stat.ullAvailPhys // (1024**2)} MB"
            # Commit limit = RAM + page file, so the difference is the page file size
            pagefile = max(0, stat.ullTotalPageFile - stat.ullTotalPhys)
            meminfo["page file"] = f"{pagefile // (1024**2)} MB"
        except Exception:
            pass

    elif os_name == "Darwin":
        try:
            # Basic total RAM for macOS
            total_bytes = int(subprocess.check_output(["sysctl", "-n", "hw.memsize"]).strip())
            meminfo["total"] = f"{total_bytes // (1024**2)} MB"
            meminfo["available"] = "N/A"  # Available RAM is complex to parse reliably on macOS
        except Exception:
            pass
        # e.g. "total = 2048.00M  used = 1037.25M  free = 1010.75M  (encrypted)"
        swap = run_command("sysctl -n vm.swapusage")
        m = re.search(r"total = ([\d.]+)M\s+used = ([\d.]+)M", swap or "")
        if m:
            meminfo["swap total"] = f"{int(float(m.group(1)))} MB"
            meminfo["swap used"] = f"{int(float(m.group(2)))} MB"

    return meminfo

def get_gpu_info():
    os_name = platform.system()
    if os_name == "Windows":
        result = run_command('powershell -Command "Get-CimInstance Win32_VideoController | Select-Object -ExpandProperty Name"')
        return result or "Not available"
    elif os_name == "Darwin":
        result = run_command("system_profiler SPDisplaysDataType | grep 'Chipset Model'")
        return result or "Not available"
    # PCI display classes only ("Non-VGA unclassified device" must not match)
    gpu = run_command("lspci | grep -E 'VGA compatible controller|3D controller|Display controller'")
    return gpu or "Not available"

def format_size(n):
    """Compact size: 512M, 1.1G, 937G, 3.6T."""
    for unit in ["B", "K", "M", "G", "T"]:
        if n < 1024 or unit == "T":
            return f"{n:.1f}{unit}" if n < 10 and unit != "B" else f"{n:.0f}{unit}"
        n /= 1024

def _unescape_mount(path):
    """/proc/mounts encodes spaces etc. as octal escapes (e.g. \\040)."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), path)

def get_disk_info():
    disks = []
    seen = set()
    os_name = platform.system()

    def add_disk(path, fstype="-", key=None):
        try:
            if key is None:
                key = os.stat(path).st_dev
            if key in seen:
                return
            usage = shutil.disk_usage(path)
            seen.add(key)
            disks.append({
                "mount": path,
                "type": fstype,
                "size": format_size(usage.total),
                "used": format_size(usage.used),
                "avail": format_size(usage.free),
                "use%": f"{int(usage.used / usage.total * 100)}%" if usage.total else "-"
            })
        except Exception:
            pass

    if os_name == "Windows":
        import string
        for letter in string.ascii_uppercase:
            path = f"{letter}:\\"
            if os.path.exists(path):
                add_disk(path, key=path)

    elif os_name == "Darwin":
        add_disk("/")
        if os.path.exists("/Volumes"):
            for name in os.listdir("/Volumes"):
                full_path = os.path.join("/Volumes", name)
                if os.path.ismount(full_path):
                    add_disk(full_path)

    else:
        try:
            with open("/proc/mounts", encoding="utf-8", errors="replace") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) < 3 or parts[2] not in REAL_FS:
                        continue
                    # Keyed by device so bind mounts and btrfs subvolumes appear once
                    add_disk(_unescape_mount(parts[1]), parts[2], key=parts[0])
        except Exception:
            for path in ["/", "/home"]:
                add_disk(path)

    return disks

def get_os_info():
    data = {"system": platform.system()}
    if platform.system() == "Linux":
        distro = get_linux_distro()
        if distro:
            data["distro"] = distro
    data["release"] = platform.release()
    data["version"] = platform.version()
    data["hostname"] = platform.node()
    uptime = get_uptime()
    if uptime:
        data["uptime"] = uptime
    return data

def print_key_values(data):
    for k, v in data.items():
        print(f"  {k.capitalize():<12}: {v}")

def main():
    section("OS Information")
    print_key_values(get_os_info())

    section("CPU Information")
    print_key_values(get_cpu_info())

    section("Memory (RAM)")
    print_key_values(get_ram_info())

    section("GPU Information")
    gpu = get_gpu_info()
    if gpu and gpu != "Not available":
        for line in gpu.splitlines():
            print(f"  {line.strip()}")
    else:
        print(f"  {gpu}")

    section("Disk Usage")
    disks = get_disk_info()
    if not disks:
        print("  No disk information available.")
    else:
        w = max(15, max(len(d["mount"]) for d in disks))
        header = f"  {'Mount':<{w}} {'Type':<7} {'Size':<6} {'Used':<6} {'Avail':<6} {'Use%'}"
        print(header)
        print("  " + "-" * (len(header) - 2))
        for d in disks:
            print(f"  {d['mount']:<{w}} {d['type']:<7} {d['size']:<6} {d['used']:<6} {d['avail']:<6} {d['use%']}")

    print()

if __name__ == "__main__":
    main()
